# Copy to .env (never commit .env)
ENV=current-env (dev, test, prod)
LOG_LEVEL=INFO

# Database (psycopg3 driver)
DATABASE_URL=your-database-url

# LLM: DeepSeek (OpenAI-compatible API)
DEEPSEEK_API_KEY=your-deepseek-api-key
DEEPSEEK_BASE_URL=https://api.deepseek.com
LLM_MODEL_FAST=your-fast-model
LLM_MODEL_MAIN=your-main-model

# Embeddings: Voyage API (all environments)
VOYAGE_API_KEY=your-voyage-api-key
EMBEDDING_MODEL=voyage-multimodal-3.5
EMBEDDING_DIM=1024                 # must match VECTOR(n) in the schema
EMBEDDING_REQUESTS_PER_MINUTE=500   # In case the API Usage has limits

CORS_ORIGINS='["your-cors-origins"]'

# Retrieval tuning
RETRIEVAL_CANDIDATES=your-retrieval-candidates
RERANK_TOP_K=your-rerank-top-k
ABSTAIN_SCORE_THRESHOLD=your-abstain-score-threshold

# Observability (optional)
LANGFUSE_PUBLIC_KEY=your-langfuse-public-key
LANGFUSE_SECRET_KEY=your-langfuse-secret-key
LANGFUSE_HOST=your-langfuse-host
