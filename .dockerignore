# ── Version Control ──────────────────────────────────────────────
.git
.gitignore

# ── Environment / Secrets ────────────────────────────────────────
.env
*.env
.env.local
.env.*.local

# ── Python ───────────────────────────────────────────────────────
**/__pycache__
**/*.pyc
**/*.pyo
.venv
venv
.mypy_cache
.ruff_cache
.pytest_cache

# ── Node / Next.js ───────────────────────────────────────────────
frontend/node_modules
frontend/.next
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# ── Editor / OS ──────────────────────────────────────────────────
.DS_Store
Thumbs.db
.idea
.vscode

# ── Docs / Drafts (not needed in any image) ──────────────────────
*.md
