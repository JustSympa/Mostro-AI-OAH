# ── Default: LF everywhere ─────────────────────────────────────
* text=auto eol=lf

# ── Shell scripts MUST be LF — CRLF breaks Linux shebang ──────
*.sh text eol=lf
*.bash text eol=lf

# ── Python scripts ─────────────────────────────────────────────
*.py text eol=lf

# ── Docker / Config ────────────────────────────────────────────
Dockerfile text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.toml text eol=lf
*.ini text eol=lf
*.cfg text eol=lf
alembic.ini text eol=lf

# ── Web / TypeScript ───────────────────────────────────────────
*.ts text eol=lf
*.tsx text eol=lf
*.js text eol=lf
*.jsx text eol=lf
*.json text eol=lf
*.css text eol=lf
*.html text eol=lf
*.md text eol=lf

# ── Binary files — no line-ending conversion ───────────────────
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.svg binary
*.woff binary
*.woff2 binary
*.ttf binary
*.eot binary
